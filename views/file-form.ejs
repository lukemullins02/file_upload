<body class="roboto-text">
  <main class="login">
    <form
      class="single-form"
      method="POST"
      enctype="multipart/form-data"
      action="/file-upload"
    >
      <div>
        <label for="file">Upload File </label>
        <input type="file" name="file" id="file" required />
      </div>
      <input type="submit" name="submit" id="submit" value="Submit" />
    </form>
  </main>
</body>
