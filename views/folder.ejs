<body class="roboto-text">
  <%- include("partials/navbar.ejs") %>
  <div class="folder-view-cent">
  <a class="btn-center" href="/folder/<%= folder.id %>/update">Update Folder</a>
  <a class="btn-center" href="/folder/<%= folder.id %>/delete">Delete Folder</a>
  </div>
  <%- include("forms/file-form.ejs") %>
  <div class="container">
    <% for(let i = 0; i < files.length; i++){ %>
    <a class="btn-fold" href="/folder/<%= folder.id %>/file/<%= files[i].id %>"><img class="fold-img" src="/file.svg" /><span class="file-name"><%= files[i].name %></span> </a>
  <% } %>
  </div>
</body>
