generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id Int @id @default(autoincrement())
  username String @unique
  password String 
  folders Folder[]
  files File[]
  @@map("users")
}

model Folder{
  id Int @id @default(autoincrement())
  name String 
  user User @relation(fields: [userId], references: [id])
  userId Int @map("user_id")
  files File[]
  @@map("folders")
}

model File{
  id Int @id @default(autoincrement())
  name String 
  size Int
  uploadAt DateTime @default(now())
  url String
  user User @relation(fields: [userId], references: [id])
  userId Int @map("user_id")
  folder Folder @relation(fields: [folderId], references: [id])
  folderId Int @map("folder_id")
  @@map("files")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt   DateTime
  @@map("sessions")
}